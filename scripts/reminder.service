[Unit]
Description=Reminder - Quran, Hadith & Names of Allah
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/reminder
EnvironmentFile=-/opt/reminder/.env
ExecStart=/opt/reminder/reminder --serve --web
Restart=on-failure
RestartSec=5
StandardOutput=append:/opt/reminder/reminder.log
StandardError=append:/opt/reminder/reminder.log

# Hardening
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/opt/reminder

[Install]
WantedBy=multi-user.target
